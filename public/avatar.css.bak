/* =========================================================
   NOOK AIRLINE — 2D MAPLE SKY LOUNGE & CHIBI AVATAR ENGINE
   Cozy retro chibi aesthetics for long-distance calls.
   ========================================================= */

/* =========================================================
   2D MAPLE AIRLINER CABIN STAGE
   Authentic retro pixel-art airplane interior
   ========================================================= */
.sky-lounge {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 4;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background-color: #0d121f;
  background-image: url('assets/scenes/classic_portrait.jpg');
  background-size: cover;
  background-position: center bottom;
  background-repeat: no-repeat;
  /* Painted MapleStory-style art: smooth scaling (pixelated looks blocky on 3x Retina) */
  image-rendering: auto;
  user-select: none;
  -webkit-user-select: none;
  touch-action: manipulation;
  transition: opacity 0.5s ease, visibility 0.5s;
}

/* Wide screen / desktop / landscape layout */
@media (min-aspect-ratio: 1/1), (min-width: 820px) {
  .sky-lounge {
    background-image: url('assets/scenes/classic_wide.jpg');
    background-position: center bottom;
  }
}

/* =========================================================
   SCENERY & CABIN ATMOSPHERE THEMES
   Each scene ships a 9:16 phone image and a 16:9 wide image
   (assets/scenes/<id>_portrait.jpg / <id>_wide.jpg).
   ========================================================= */
/* 0. Game of Thrones: Winterfell Godswood & Stark Hearth */
.sky-lounge.theme-winterfell { background-image: url('assets/scenes/winterfell_portrait.jpg'); }
.sky-lounge.theme-winterfell .cabin-ambient-light {
  background: radial-gradient(ellipse at 50% 0%, rgba(251, 146, 60, 0.28) 0%, rgba(30, 41, 59, 0.45) 50%, transparent 80%);
}

/* 1. Royal First Class */
.sky-lounge.theme-classic { background-image: url('assets/scenes/classic_portrait.jpg'); }
.sky-lounge.theme-classic .cabin-ambient-light {
  background: radial-gradient(ellipse at 50% 0%, rgba(254, 215, 170, 0.18) 0%, transparent 75%);
}

/* 2. Kyoto Sakura Shrine (Japan) */
.sky-lounge.theme-kyoto { background-image: url('assets/scenes/kyoto_portrait.jpg'); }
.sky-lounge.theme-kyoto .cabin-ambient-light {
  background: radial-gradient(ellipse at 50% 0%, rgba(251, 146, 60, 0.30) 0%, rgba(244, 114, 182, 0.18) 40%, transparent 80%);
}

/* 3. Santorini Sunset Cliffside (Greece) */
.sky-lounge.theme-santorini { background-image: url('assets/scenes/santorini_portrait.jpg'); }
.sky-lounge.theme-santorini .cabin-ambient-light {
  background: radial-gradient(ellipse at 50% 0%, rgba(244, 114, 182, 0.30) 0%, rgba(56, 189, 248, 0.22) 45%, transparent 80%);
}

/* 4. Paris Seine & Eiffel Tower Night (France) */
.sky-lounge.theme-paris { background-image: url('assets/scenes/paris_portrait.jpg'); }
.sky-lounge.theme-paris .cabin-ambient-light {
  background: radial-gradient(ellipse at 50% 0%, rgba(254, 215, 170, 0.26) 0%, rgba(30, 58, 138, 0.35) 50%, transparent 80%);
}

/* 5. Maldives Overwater Lagoon Sunset (Maldives) */
.sky-lounge.theme-maldives { background-image: url('assets/scenes/maldives_portrait.jpg'); }
.sky-lounge.theme-maldives .cabin-ambient-light {
  background: radial-gradient(ellipse at 50% 0%, rgba(45, 212, 191, 0.28) 0%, rgba(251, 146, 60, 0.22) 45%, transparent 80%);
}

/* 6. Swiss Zermatt Village & Matterhorn Galaxy (Switzerland) */
.sky-lounge.theme-swiss { background-image: url('assets/scenes/swiss_portrait.jpg'); }
.sky-lounge.theme-swiss .cabin-ambient-light {
  background: radial-gradient(ellipse at 50% 0%, rgba(192, 132, 252, 0.28) 0%, rgba(186, 230, 253, 0.22) 45%, transparent 80%);
}

/* 7. Dubai Desert Oasis & Burj Mirage (UAE) */
.sky-lounge.theme-dubai { background-image: url('assets/scenes/dubai_portrait.jpg'); }
.sky-lounge.theme-dubai .cabin-ambient-light {
  background: radial-gradient(ellipse at 50% 0%, rgba(251, 191, 36, 0.32) 0%, rgba(217, 119, 6, 0.20) 45%, transparent 80%);
}

/* 8. Monte Carlo Casino Palace & Penthouse (Monaco) */
.sky-lounge.theme-montecarlo { background-image: url('assets/scenes/montecarlo_portrait.jpg'); }
.sky-lounge.theme-montecarlo .cabin-ambient-light {
  background: radial-gradient(ellipse at 50% 0%, rgba(5, 150, 105, 0.28) 0%, rgba(245, 158, 11, 0.22) 45%, transparent 80%);
}

/* 9. Atlantis Undersea Palace (Atlantis) */
.sky-lounge.theme-atlantis { background-image: url('assets/scenes/atlantis_portrait.jpg'); }
.sky-lounge.theme-atlantis .cabin-ambient-light {
  background: radial-gradient(ellipse at 50% 0%, rgba(6, 182, 212, 0.34) 0%, rgba(59, 130, 246, 0.22) 45%, transparent 80%);
}

/* 10. Starlight Celestial Observatory (Season 6) */
.sky-lounge.theme-starlight { background-image: url('assets/scenes/starlight_portrait.jpg'); }
.sky-lounge.theme-starlight .cabin-ambient-light {
  background: radial-gradient(ellipse at 50% 0%, rgba(168, 85, 247, 0.32) 0%, rgba(245, 158, 11, 0.24) 45%, transparent 80%);
}

/* Wide / landscape versions */
@media (min-aspect-ratio: 1/1), (min-width: 820px) {
  .sky-lounge.theme-winterfell { background-image: url('assets/scenes/winterfell_wide.jpg'); }
  .sky-lounge.theme-classic { background-image: url('assets/scenes/classic_wide.jpg'); }
  .sky-lounge.theme-kyoto { background-image: url('assets/scenes/kyoto_wide.jpg'); }
  .sky-lounge.theme-santorini { background-image: url('assets/scenes/santorini_wide.jpg'); }
  .sky-lounge.theme-paris { background-image: url('assets/scenes/paris_wide.jpg'); }
  .sky-lounge.theme-maldives { background-image: url('assets/scenes/maldives_wide.jpg'); }
  .sky-lounge.theme-swiss { background-image: url('assets/scenes/swiss_wide.jpg'); }
  .sky-lounge.theme-dubai { background-image: url('assets/scenes/dubai_wide.jpg'); }
  .sky-lounge.theme-montecarlo { background-image: url('assets/scenes/montecarlo_wide.jpg'); }
  .sky-lounge.theme-atlantis { background-image: url('assets/scenes/atlantis_wide.jpg'); }
  .sky-lounge.theme-starlight { background-image: url('assets/scenes/starlight_wide.jpg'); }
}

/* Cabin Atmosphere Flash Overlay */
.cabin-atmosphere-flash {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0) 70%);
  opacity: 0;
  pointer-events: none;
  z-index: 3;
}
.cabin-atmosphere-flash.flash-active {
  animation: atmosphereFlashPulse 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
@keyframes atmosphereFlashPulse {
  0% { opacity: 0.65; }
  100% { opacity: 0; }
}

/* Subtle Golden Cabin Ambient Cove Glow */
.cabin-ambient-light {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 38%;
  background: radial-gradient(ellipse at 50% 0%, rgba(254, 215, 170, 0.16) 0%, transparent 75%);
  pointer-events: none;
  animation: cabinAmbientGlow 6s ease-in-out infinite alternate;
  z-index: 2;
  transition: background 0.8s ease;
}

@keyframes cabinAmbientGlow {
  0% { opacity: 0.6; }
  100% { opacity: 0.95; }
}

/* Interactive Walkable Floor Container */
.lounge-floor {
  position: absolute;
  inset: 0;
  cursor: pointer;
  overflow: hidden;
  z-index: 5;
  background: transparent;
}

/* Tap Target Ripple Indicator */
.tap-ripple {
  position: absolute;
  width: 32px;
  height: 16px;
  border-radius: 50%;
  border: 2px solid var(--gold-primary);
  transform: translate(-50%, -50%) scale(0.2);
  opacity: 1;
  pointer-events: none;
  animation: ripplePop 0.6s cubic-bezier(0.1, 0.9, 0.2, 1) forwards;
}

@keyframes ripplePop {
  0% { transform: translate(-50%, -50%) scale(0.2); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1.6); opacity: 0; }
}

/* =========================================================
   CHIBI / MAPLESTORY AVATAR COMPONENT
   ========================================================= */
.avatar-entity {
  position: absolute;
  width: 76px;
  height: 104px;
  transform-origin: bottom center;
  transition: left 1.1s cubic-bezier(0.25, 1, 0.5, 1), top 1.1s cubic-bezier(0.25, 1, 0.5, 1);
  will-change: left, top, transform;
  z-index: 10;
}

/* Floor Shadow */
.avatar-shadow {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48px;
  height: 14px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  filter: blur(2px);
  transition: transform 0.2s ease;
}

/* Avatar Sprite Container */
.avatar-body-wrapper {
  position: absolute;
  bottom: 6px;
  left: 50%;
  transform: translateX(-50%);
  width: 72px;
  height: 96px;
  transform-origin: bottom center;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* Maple Idle Breathing Bob */
.avatar-entity.idle .avatar-body-wrapper {
  animation: mapleIdle 2.2s ease-in-out infinite;
}

@keyframes mapleIdle {
  0%, 100% { transform: translateX(-50%) translateY(0) scale(1, 1); }
  50% { transform: translateX(-50%) translateY(-3px) scale(0.99, 1.02); }
}

/* Cute Happy Bounce (Autonomous micro-flavor) */
.avatar-entity.happy-bounce .avatar-body-wrapper {
  animation: happyHop 0.5s ease-in-out !important;
}
@keyframes happyHop {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  40% { transform: translateX(-50%) translateY(-14px) scale(1.05); }
  70% { transform: translateX(-50%) translateY(-2px); }
}

/* Maple Walking Step Cycle */
.avatar-entity.walking .avatar-body-wrapper {
  animation: mapleWalk 0.32s ease-in-out infinite alternate;
}

@keyframes mapleWalk {
  0% { transform: translateX(-50%) translateY(0) rotate(-2deg); }
  100% { transform: translateX(-50%) translateY(-6px) rotate(2deg); }
}

/* Direction Flip */
.avatar-entity.facing-left .avatar-body-wrapper {
  transform: translateX(-50%) scaleX(-1);
}
.avatar-entity.facing-left.idle .avatar-body-wrapper {
  animation: mapleIdleLeft 2.2s ease-in-out infinite;
}
@keyframes mapleIdleLeft {
  0%, 100% { transform: translateX(-50%) scaleX(-1) translateY(0); }
  50% { transform: translateX(-50%) scaleX(-1) translateY(-3px); }
}
.avatar-entity.facing-left.happy-bounce .avatar-body-wrapper {
  animation: happyHopLeft 0.5s ease-in-out !important;
}
@keyframes happyHopLeft {
  0%, 100% { transform: translateX(-50%) scaleX(-1) translateY(0); }
  40% { transform: translateX(-50%) scaleX(-1) translateY(-14px) scale(1.05); }
  70% { transform: translateX(-50%) scaleX(-1) translateY(-2px); }
}
.avatar-entity.facing-left.walking .avatar-body-wrapper {
  animation: mapleWalkLeft 0.32s ease-in-out infinite alternate;
}
@keyframes mapleWalkLeft {
  0% { transform: translateX(-50%) scaleX(-1) translateY(0) rotate(-2deg); }
  100% { transform: translateX(-50%) scaleX(-1) translateY(-6px) rotate(2deg); }
}

/* Avatar Name Tag */
.avatar-tag {
  position: absolute;
  bottom: -22px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(14, 20, 36, 0.85);
  border: 1px solid rgba(212, 175, 55, 0.4);
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 10px;
  white-space: nowrap;
  pointer-events: none;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  gap: 4px;
}

.avatar-tag.me {
  border-color: rgba(16, 185, 129, 0.5);
  color: #a7f3d0;
}

.tag-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #10b981;
}

/* Voice Talking Musical Note / Bubble */
.avatar-voice-bubble {
  position: absolute;
  top: -24px;
  left: 50%;
  transform: translateX(-50%) scale(0);
  background: var(--gold-gradient);
  color: #0b0f19;
  font-size: 11px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 12px;
  box-shadow: 0 4px 12px rgba(212, 175, 55, 0.4);
  pointer-events: none;
  opacity: 0;
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s;
  display: flex;
  align-items: center;
  gap: 3px;
  z-index: 15;
}

.avatar-entity.talking .avatar-voice-bubble {
  transform: translateX(-50%) scale(1);
  opacity: 1;
}

/* Avatar SVG Layers */
.chibi-svg {
  width: 72px;
  height: 96px;
  overflow: visible;
}

/* Mouth talking animation */
.mouth-closed { display: block; }
.mouth-open { display: none; }
.avatar-entity.talking .mouth-closed { display: none; }
.avatar-entity.talking .mouth-open { display: block; }

/* Emote Particle Bubble above Avatar */
.avatar-emote-bubble {
  position: absolute;
  top: -38px;
  left: 50%;
  transform: translateX(-50%) scale(0);
  pointer-events: none;
  z-index: 20;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.25s;
  opacity: 0;
}

.avatar-emote-bubble.active {
  transform: translateX(-50%) scale(1.15);
  opacity: 1;
}

/* =========================================================
   EMOTIONAL SENSORY WARM HUG SYSTEM
   ========================================================= */

/* 1. Screen Warmth Vignette (Soft rose-amber glow across edges) */
.hug-screen-vignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 6;
  opacity: 0;
  background: radial-gradient(circle at 50% 58%, transparent 30%, rgba(244, 63, 94, 0.16) 70%, rgba(225, 29, 72, 0.32) 100%);
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}
.hug-screen-vignette.active {
  opacity: 1;
  animation: hugVignettePulse 2.1s ease-in-out infinite alternate;
}
@keyframes hugVignettePulse {
  0% { opacity: 0.75; transform: scale(1); }
  100% { opacity: 1; transform: scale(1.02); }
}

/* 2. In-World Avatar Hug Animations & Organic Interlocking Embrace */
.avatar-entity.in-hug-left {
  z-index: 10 !important;
  transform-origin: bottom center;
  animation: hugCoupleLeanLeft 2.2s ease-in-out infinite alternate !important;
}

.avatar-entity.in-hug-right {
  z-index: 11 !important;
  transform-origin: bottom center;
  animation: hugCoupleLeanRight 2.2s ease-in-out infinite alternate !important;
}

@keyframes hugCoupleLeanLeft {
  0% { transform: rotate(4.5deg) translateY(0) scale(1.02); }
  50% { transform: rotate(6deg) translateY(-2px) scale(1.04); }
  100% { transform: rotate(4.5deg) translateY(0) scale(1.02); }
}

@keyframes hugCoupleLeanRight {
  0% { transform: scaleX(-1) rotate(4.5deg) translateY(0) scale(1.02); }
  50% { transform: scaleX(-1) rotate(6deg) translateY(-2px) scale(1.04); }
  100% { transform: scaleX(-1) rotate(4.5deg) translateY(0) scale(1.02); }
}

/* Hug Facial Features & Animated Arms on Avatars */
.avatar-hug-blush {
  position: absolute;
  top: 44%;
  left: 50%;
  transform: translateX(-50%);
  width: 44px;
  height: 10px;
  display: flex;
  justify-content: space-between;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.4s ease;
  z-index: 5;
}
.avatar-entity.in-hug .avatar-hug-blush {
  opacity: 1;
}
.hug-blush-cheek {
  width: 12px;
  height: 7px;
  border-radius: 50%;
  background: rgba(244, 63, 94, 0.75);
  filter: blur(1.5px);
}

.avatar-hug-eyes {
  position: absolute;
  top: 35%;
  left: 50%;
  transform: translateX(-50%);
  width: 32px;
  height: 6px;
  display: flex;
  justify-content: space-between;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.4s ease;
  z-index: 6;
}
.avatar-entity.in-hug .avatar-hug-eyes {
  opacity: 1;
}
.hug-smile-eye {
  width: 8px;
  height: 5px;
  border-top: 2.5px solid #1e1b4b;
  border-radius: 50% 50% 0 0;
}

/* Wrapping Arm Around Partner */
.avatar-hug-arm {
  position: absolute;
  top: 52%;
  right: -10px;
  width: 24px;
  height: 12px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.9);
  border: 1.5px solid rgba(0, 0, 0, 0.25);
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
  opacity: 0;
  transform-origin: left center;
  transition: opacity 0.3s ease;
  z-index: 7;
}
.avatar-entity.in-hug .avatar-hug-arm {
  opacity: 1;
  animation: hugArmSqueeze 2.2s ease-in-out infinite alternate;
}
@keyframes hugArmSqueeze {
  0% { transform: rotate(6deg); }
  100% { transform: rotate(11deg); }
}

/* 3. Ground Warmth Halo Under Couple */
.hug-ground-halo {
  position: absolute;
  left: 50%;
  top: 58%;
  transform: translate(-50%, -40%);
  width: 170px;
  height: 52px;
  border-radius: 50%;
  background: radial-gradient(ellipse at 50% 50%, rgba(251, 113, 133, 0.55) 0%, rgba(254, 215, 170, 0.25) 55%, transparent 75%);
  filter: blur(5px);
  pointer-events: none;
  z-index: 7;
  opacity: 0;
  transition: opacity 0.6s ease;
}
.hug-ground-halo.active {
  opacity: 1;
  display: block !important;
  animation: hugGroundHaloPulse 2s ease-in-out infinite alternate;
}
@keyframes hugGroundHaloPulse {
  0% { transform: translate(-50%, -40%) scale(0.9); opacity: 0.7; }
  100% { transform: translate(-50%, -40%) scale(1.15); opacity: 1; }
}

/* 4. Floating Pixel Hearts from Couple */
.hug-carpet-hearts {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: visible;
  z-index: 15;
}
.hug-pixel-heart {
  position: absolute;
  font-size: 16px;
  line-height: 1;
  pointer-events: none;
  animation: hugPixelHeartRise 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
@keyframes hugPixelHeartRise {
  0% { transform: translate(0, 0) scale(0.4); opacity: 0; }
  20% { opacity: 1; transform: translate(var(--dx, 0), -20px) scale(1.25); }
  100% { transform: translate(var(--dx, 0), -85px) scale(0.8); opacity: 0; }
}

/* =========================================================
   EMOTION DECK BAR (Feelings: Hug, Kiss, Cry, Sleep, Dance)
   ========================================================= */
.emotion-deck {
  position: absolute;
  bottom: max(90px, calc(80px + env(safe-area-inset-bottom, 0px)));
  left: 50%;
  transform: translateX(-50%);
  z-index: 25;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  max-width: min(95vw, 760px);
  overflow-x: auto;
  scrollbar-width: none;
  border-radius: 28px;
  background: rgba(14, 20, 36, 0.88);
  border: 1px solid rgba(212, 175, 55, 0.4);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  transition: all 0.3s ease;
}
.emotion-deck::-webkit-scrollbar {
  display: none;
}

.emote-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  background: transparent;
  border: none;
  color: #fff;
  cursor: pointer;
  padding: 6px 10px;
  border-radius: 16px;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  -webkit-tap-highlight-color: transparent;
  flex-shrink: 0;
}

.emote-btn:hover, .emote-btn:focus-visible {
  background: rgba(212, 175, 55, 0.2);
  transform: translateY(-2px) scale(1.08);
}

.emote-btn:active {
  transform: scale(0.92);
}

.emote-icon {
  font-size: 20px;
  line-height: 1;
  filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.4));
}

.emote-label {
  font-size: 10px;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 0.3px;
}

/* Hero Warm Hug Button */
.emote-btn.hug-hero-btn {
  position: relative;
  background: linear-gradient(135deg, rgba(244, 63, 94, 0.24) 0%, rgba(251, 146, 60, 0.2) 100%);
  border: 1.5px solid rgba(251, 113, 133, 0.6);
  box-shadow: 0 0 16px rgba(244, 63, 94, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  padding: 6px 16px;
  border-radius: 18px;
}
.emote-btn.hug-hero-btn:hover {
  background: linear-gradient(135deg, rgba(244, 63, 94, 0.38) 0%, rgba(251, 146, 60, 0.3) 100%);
  border-color: #fb7185;
  box-shadow: 0 0 24px rgba(244, 63, 94, 0.55);
  transform: translateY(-2px) scale(1.06);
}
.emote-btn.hug-hero-btn .emote-label {
  color: #fda4af;
  font-weight: 700;
}
.emote-btn.hug-hero-btn .emote-icon {
  font-size: 22px;
  animation: heroHugPulse 1.8s ease-in-out infinite;
}
@keyframes heroHugPulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.18); }
  100% { transform: scale(1); }
}

.hug-btn-pulse-ring {
  position: absolute;
  inset: -3px;
  border-radius: 20px;
  border: 1.5px solid rgba(244, 63, 94, 0.6);
  opacity: 0;
  pointer-events: none;
}
.emote-btn.hug-hero-btn.holding .hug-btn-pulse-ring {
  animation: hugRingExpand 0.9s cubic-bezier(0.16, 1, 0.3, 1) infinite;
}
@keyframes hugRingExpand {
  0% { transform: scale(0.95); opacity: 0.9; }
  100% { transform: scale(1.3); opacity: 0; }
}

.emote-btn.wardrobe-btn {
  border-left: 1px solid rgba(255, 255, 255, 0.12);
  padding-left: 12px;
  margin-left: 4px;
}
.emote-btn.wardrobe-btn .emote-label {
  color: var(--gold-primary);
}

.emote-btn.scenery-btn {
  border-left: 1px solid rgba(255, 255, 255, 0.12);
  padding-left: 12px;
  margin-left: 2px;
}
.emote-btn.scenery-btn .emote-label {
  color: #38bdf8;
}

/* =========================================================
   WARDROBE / FITTING ROOM MODAL
   ========================================================= */
.wardrobe-modal {
  position: absolute;
  inset: 0;
  z-index: 50;
  background: rgba(7, 9, 14, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.wardrobe-modal.active {
  opacity: 1;
  pointer-events: auto;
}

.wardrobe-card {
  width: min(100%, 460px);
  max-height: 88vh;
  overflow-y: auto;
  background: #111728;
  border: 1px solid rgba(212, 175, 55, 0.35);
  border-radius: 28px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7);
  display: flex;
  flex-direction: column;
}

.wardrobe-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 24px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.wardrobe-title {
  font-family: var(--font-heading);
  font-size: 20px;
  font-weight: 700;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 8px;
}

.wardrobe-close-btn {
  background: rgba(255, 255, 255, 0.08);
  border: none;
  color: var(--text-muted);
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
}
.wardrobe-close-btn:hover {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
}

/* Wardrobe Live Preview Area */
.wardrobe-preview-stage {
  padding: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle, #1a2238 0%, #111728 75%);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  position: relative;
}

.preview-avatar-box {
  position: relative;
  width: 88px;
  height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Character Selection Grid */
.wardrobe-options {
  padding: 20px 24px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  max-height: 420px;
  overflow-y: auto;
}

.wardrobe-option-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 10px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #fff;
  cursor: pointer;
  transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  -webkit-tap-highlight-color: transparent;
}

.wardrobe-option-btn:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(212, 175, 55, 0.4);
  transform: translateY(-2px);
}

.wardrobe-option-btn:active {
  transform: scale(0.96);
}

.wardrobe-option-btn.selected {
  background: rgba(212, 175, 55, 0.16);
  border: 2px solid var(--gold-primary);
  box-shadow: 0 0 16px rgba(212, 175, 55, 0.35);
}

.character-thumb {
  height: 60px;
  width: auto;
  object-fit: contain;
  image-rendering: pixelated;
  filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.45));
  transition: transform 0.2s ease;
}

.wardrobe-option-btn:hover .character-thumb {
  transform: scale(1.08);
}

.option-badge {
  font-size: 10px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 10px;
  background: rgba(212, 175, 55, 0.2);
  color: var(--gold-light);
  border: 1px solid rgba(212, 175, 55, 0.35);
  letter-spacing: 0.3px;
}

.option-title {
  font-size: 12px;
  font-weight: 700;
  text-align: center;
  color: #fff;
  letter-spacing: 0.2px;
}

/* Authentic MapleStory Pixel Art Sprite Rendering & Multi-Frame Animation */
.maple-sprite-container {
  position: relative;
  width: 98px;
  height: 98px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.maple-sprite-container.preview {
  width: 108px;
  height: 108px;
}

.maple-sprite-img {
  display: block;
  height: 98px;
  width: auto;
  max-width: 110px;
  object-fit: contain;
  image-rendering: -webkit-optimize-contrast;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
  filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.45));
  user-select: none;
  -webkit-user-drag: none;
  pointer-events: none;
  transition: opacity 0.1s ease;
}

.maple-sprite-img.preview {
  height: 108px;
  max-width: 120px;
}

/* Multi-Frame Animation State Switching */
.maple-sprite-container .sprite-idle {
  display: block;
}
.maple-sprite-container .sprite-walk,
.maple-sprite-container .sprite-slash {
  display: none;
}

/* Walking motion: Step-forward pose with sword raised and cloak flowing (only when sprite-walk exists) */
.avatar-entity.walking .maple-sprite-container.has-walk .sprite-idle {
  display: none;
}
.avatar-entity.walking .maple-sprite-container.has-walk .sprite-walk {
  display: block;
}

/* Sword Slash Attack: Luminous blue energy slash wave (only when sprite-slash exists) */
.avatar-entity.slashing .maple-sprite-container.has-slash .sprite-idle,
.avatar-entity.slashing .maple-sprite-container.has-slash .sprite-walk {
  display: none;
}
.avatar-entity.slashing .maple-sprite-container.has-slash .sprite-slash {
  display: block;
  filter: drop-shadow(0 0 14px rgba(56, 189, 248, 0.85)) drop-shadow(0 4px 8px rgba(0, 0, 0, 0.5));
}

/* Dynamic Sword Slash Movement Animation */
.avatar-entity.slashing .avatar-body-wrapper {
  animation: mapleSlashStrike 0.72s cubic-bezier(0.2, 0.8, 0.2, 1) !important;
}

@keyframes mapleSlashStrike {
  0% { transform: translateX(-50%) translateY(0) scale(1); }
  25% { transform: translateX(-62%) translateY(-6px) scale(1.12) rotate(-6deg); }
  50% { transform: translateX(-38%) translateY(-2px) scale(1.22) rotate(8deg); }
  75% { transform: translateX(-48%) translateY(-1px) scale(1.05); }
  100% { transform: translateX(-50%) translateY(0) scale(1); }
}

.avatar-entity.facing-left.slashing .avatar-body-wrapper {
  animation: mapleSlashStrikeLeft 0.72s cubic-bezier(0.2, 0.8, 0.2, 1) !important;
}

@keyframes mapleSlashStrikeLeft {
  0% { transform: translateX(-50%) scaleX(-1) translateY(0) scale(1); }
  25% { transform: translateX(-38%) scaleX(-1) translateY(-6px) scale(1.12) rotate(-6deg); }
  50% { transform: translateX(-62%) scaleX(-1) translateY(-2px) scale(1.22) rotate(8deg); }
  75% { transform: translateX(-52%) scaleX(-1) translateY(-1px) scale(1.05); }
  100% { transform: translateX(-50%) scaleX(-1) translateY(0) scale(1); }
}

/* Authentic MapleStory Critical Damage Popup */
.maple-damage-pop {
  position: absolute;
  transform: translate(-50%, -50%);
  font-family: 'Outfit', 'Inter', -apple-system, sans-serif;
  font-size: 15px;
  font-weight: 900;
  letter-spacing: 0.5px;
  background: linear-gradient(180deg, #ffea79 0%, #ff7b00 45%, #e11d48 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 2px 0 #4c0519) drop-shadow(0 0 10px rgba(239, 68, 68, 0.8));
  pointer-events: none;
  z-index: 60;
  animation: mapleDamageFloat 1.1s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
  white-space: nowrap;
}

@keyframes mapleDamageFloat {
  0% { opacity: 0; transform: translate(-50%, 0) scale(0.6); }
  25% { opacity: 1; transform: translate(-50%, -24px) scale(1.25); }
  60% { opacity: 1; transform: translate(-50%, -36px) scale(1.05); }
  100% { opacity: 0; transform: translate(-50%, -52px) scale(0.95); }
}

/* Wardrobe Action Footer */
.wardrobe-footer {
  padding: 16px 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  justify-content: flex-end;
}

.wardrobe-save-btn {
  background: var(--gold-gradient);
  border: none;
  color: #0b0f19;
  font-weight: 700;
  font-size: 14px;
  padding: 12px 28px;
  border-radius: var(--radius-pill);
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(212, 175, 55, 0.35);
  transition: transform 0.2s ease;
}
.wardrobe-save-btn:active {
  transform: scale(0.96);
}

/* =========================================================
   SCENERY & CABIN ATMOSPHERE MODAL
   ========================================================= */
.scenery-modal {
  position: absolute;
  inset: 0;
  z-index: 50;
  background: rgba(7, 9, 14, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.scenery-modal.active {
  opacity: 1;
  pointer-events: auto;
}

.scenery-card {
  width: min(100%, 560px);
  max-height: 88vh;
  overflow-y: auto;
  background: #111728;
  border: 1px solid rgba(56, 189, 248, 0.4);
  border-radius: 28px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.8), 0 0 35px rgba(56, 189, 248, 0.15);
  display: flex;
  flex-direction: column;
}

.scenery-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 24px 12px;
}

.scenery-title {
  font-family: var(--font-heading);
  font-size: 20px;
  font-weight: 700;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 10px;
}

.scenery-close-btn {
  background: rgba(255, 255, 255, 0.08);
  border: none;
  color: var(--text-muted);
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
}
.scenery-close-btn:hover {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
}

.scenery-lead {
  padding: 0 24px 14px;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.45;
  margin: 0;
}

.scenery-grid {
  padding: 4px 24px 20px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
  max-height: 480px;
  overflow-y: auto;
}

.scenery-option-item {
  position: relative;
  background: rgba(255, 255, 255, 0.04);
  border: 1.5px solid rgba(255, 255, 255, 0.1);
  border-radius: 18px;
  padding: 10px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  cursor: pointer;
  transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  text-align: left;
}

.scenery-option-item:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(56, 189, 248, 0.5);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
}

.scenery-option-item.selected {
  background: rgba(56, 189, 248, 0.12);
  border-color: #38bdf8;
  box-shadow: 0 0 24px rgba(56, 189, 248, 0.25);
}

.scenery-thumb-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 12px;
  overflow: hidden;
  background: #090d16;
}

.scenery-thumb-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  image-rendering: -webkit-optimize-contrast;
  image-rendering: pixelated;
  transition: transform 0.3s ease;
}

.scenery-option-item:hover .scenery-thumb-img {
  transform: scale(1.04);
}

.scenery-badge-tag {
  position: absolute;
  top: 6px;
  right: 6px;
  background: rgba(14, 20, 36, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: #fff;
  font-size: 10px;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: 999px;
  letter-spacing: 0.3px;
}

.scenery-check-badge {
  position: absolute;
  top: 6px;
  left: 6px;
  width: 22px;
  height: 22px;
  background: #38bdf8;
  color: #07090e;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 800;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  opacity: 0;
  transform: scale(0.6);
  transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.scenery-option-item.selected .scenery-check-badge {
  opacity: 1;
  transform: scale(1);
}

.scenery-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.scenery-item-name {
  font-family: var(--font-heading);
  font-size: 13px;
  font-weight: 700;
  color: #fff;
}

.scenery-item-sub {
  font-size: 11px;
  color: #94a3b8;
}

.scenery-item-mood {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.35;
  margin-top: 2px;
}

.scenery-footer {
  padding: 16px 24px 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  gap: 12px;
}

.scenery-save-btn {
  flex: 1;
  padding: 14px;
  border-radius: 16px;
  background: linear-gradient(135deg, #0284c7 0%, #38bdf8 100%);
  color: #07090e;
  font-family: var(--font-heading);
  font-size: 14px;
  font-weight: 700;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 4px 16px rgba(56, 189, 248, 0.35);
}

.scenery-save-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(56, 189, 248, 0.5);
}

.scenery-save-btn:active {
  transform: scale(0.97);
}

/* Responsive Mobile Adjustments */
@media (max-width: 480px) {
  .emotion-deck {
    bottom: 80px;
    gap: 4px;
    padding: 6px 10px;
  }
  .emote-btn {
    padding: 4px 6px;
  }
  .emote-icon {
    font-size: 18px;
  }
  .emote-label {
    font-size: 9px;
  }
  .wardrobe-options {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding: 16px;
  }
  .scenery-grid {
    grid-template-columns: 1fr;
    gap: 10px;
    padding: 4px 16px 16px;
  }
  .scenery-header {
    padding: 16px 16px 10px;
  }
  .scenery-lead {
    padding: 0 16px 12px;
    font-size: 12px;
  }
  .scenery-footer {
    padding: 12px 16px 18px;
  }
}
